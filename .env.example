# ─────────────────────────────────────────────────────────────────────────────
# Archai HR — Environment Variables (مثال)
# انسخ الملف ده لـ .env.local واملأ القيم من Supabase Dashboard:
#   Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (أساسي) ────────────────────────────────────────────────────────
# Project URL — من: Project Settings → API → Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# ANON (publishable) KEY — مفتاح عام مخصص للاستخدام من العميل.
# الحماية الفعلية تعتمد على Row Level Security (RLS) على مستوى قاعدة البيانات.
# ⚠️ لا تضع SERVICE_ROLE KEY هنا أبدًا — ممنوع منعًا باتًا في أي كود CLIENT.
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# ── App Defaults (اختياري) ──────────────────────────────────────────────────
# اللغة الافتراضية: ar | en
VITE_APP_DEFAULT_LANGUAGE=ar

# المظهر الافتراضي: dark (أساس هوية Archai) | light | system
VITE_APP_DEFAULT_THEME=dark
