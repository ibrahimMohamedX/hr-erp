# ─────────────────────────────────────────────────────────────────────────────
# Archai HR — Environment Variables (مثال)
# انسخ الملف ده لـ .env.local واملأ القيم من مشاريع Supabase المعنية.
# ─────────────────────────────────────────────────────────────────────────────

# ── Control Plane — مشروع المنصة المركزي (أساسي) ─────────────────────────────
# المشروع الذي يستضيف: قاعدة بيانات المنصة + RLS + Edge Function (tenant-admin)
# من: Project Settings → API في مشروع المنصة.
# ⚠️ هات القيمتين فقط (URL + anon) — client-safe.
VITE_PLATFORM_SUPABASE_URL=https://<platform-project-ref>.supabase.co
VITE_PLATFORM_SUPABASE_ANON_KEY=<platform-anon-public-key>

# ── أسرار الخادم (لا توضع هنا إطلاقًا — Edge Function secrets) ───────────────
# تُضبط عبر: supabase secrets set --project-ref <platform-ref>
#   SUPABASE_ACCESS_TOKEN   ← Personal Access Token بصلاحيات Management API
#   SERVICE_ROLE_KEY        ← service_role لمشروع المنصة (استعلامات إدارية)
#   SUPABASE_ORG_ID         ← معرف الـ organization المستهدف للإنشاء
#   PROVISION_REGION        ← المنطقة الافتراضية للمشاريع الجديدة (مثل eu-central-1)
#   PROVISION_DB_PASS       ← سياسة/قيمة كلمة مرور قاعدة البيانات (أو تُولَّد)
# راجع: supabase/README.md

# ── Tenant المستقل (اختياري للتطوير المحلي) ────────────────────────────────
# عميل شركة واحد للتجارب المحلية قبل اكتمال التوفير الفعلي.
VITE_SUPABASE_URL=https://<tenant-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# ── App Defaults (اختياري) ──────────────────────────────────────────────────
VITE_APP_DEFAULT_LANGUAGE=ar
VITE_APP_DEFAULT_THEME=dark
